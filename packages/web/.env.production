# Production build config for @harness/web.
#
# These are PUBLIC client values (they are compiled into the shipped JS bundle —
# not secrets): the deployed API Gateway URL, the WebSocket URL, and the Cognito
# app-client/pool/domain. They are REQUIRED at build time: without
# VITE_API_BASE_URL the bundle falls back to `/api` (baseApi.ts), which under
# CloudFront returns the SPA HTML instead of reaching the API Gateway — so every
# API call silently fails. `.env.local` is for LOCAL dev and intentionally omits
# VITE_API_BASE_URL (so `/api` proxies to the local backend); this file is what a
# production `npm run build -w @harness/web` needs.
#
# Update these if the API/WS Gateway ids or the Cognito pool/client/domain change
# (ApiStack `HttpApiUrl`/`WebSocketUrl` outputs, AuthStack Cognito outputs).
VITE_API_BASE_URL=https://l5edwucexb.execute-api.us-east-1.amazonaws.com
VITE_WS_URL=wss://fgxq7ezbl1.execute-api.us-east-1.amazonaws.com/prod
VITE_COGNITO_USER_POOL_ID=us-east-1_HqxqXElfd
VITE_COGNITO_USER_POOL_CLIENT_ID=1dp5r3ku559mn53ijfa05pn2i8
VITE_COGNITO_DOMAIN=command-hq-066756.auth.us-east-1.amazoncognito.com
