{
  "name": "@harness/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env.local dist/local/devServer.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate:pg": "node dist/scripts/migratePg.js"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1058.0",
    "@aws-sdk/client-dynamodb": "^3.693.0",
