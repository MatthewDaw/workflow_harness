node_modules/
dist/
*.tsbuildinfo
# compiled output must never live in src/ (only .ts/.tsx belongs there)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
# ...except Vite's hand-authored ambient client types — required for `tsc` on
# @harness/web (import.meta.env.VITE_*), so a fresh checkout/CI typechecks.
!packages/web/src/vite-env.d.ts
coverage/
.DS_Store
.env
.env.*
!.env.example
# Production web build config — PUBLIC client values (compiled into the bundle),
# required so the SPA reaches the real API Gateway instead of falling back to /api.
!packages/web/.env.production

# CDK
infra/cdk.out/

# Go wrapper build output
wrapper/bin/
wrapper/dist/

# editor / local
.idea/
.vscode/

# gstack local runtime + tokens (never commit)
.gstack/

# brainstorm tooling scratch (wireframe iterations, server pids)
.superpowers/

# python scaffolding (vestigial)
.venv/

# agent-families (Python / uv, self-contained — uv.lock IS committed)
agent-families/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
agent-families/build/
agent-families/dist/
# local library DB + model cache (re-derivable; never committed)
agent-families/*.db
agent-families/*.sqlite
agent-families/*.sqlite3
agent-families/.hf_cache/

infra/cdk.bundles/
infra/cdk-outputs.json
npm/claude-plus/bin/claude-plus
npm/claude-plus/bin/claude-plus.exe

.claude/worktrees/
.claude/settings.local.json

# agent-families ralph driver (mutable, never commit)
agent-families/MODEL.txt
ralph-logs/
